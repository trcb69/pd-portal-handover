<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Production Dashboard Demo Plan</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="theme.css">
<style>
@page{size:A4;margin:0}
:root{--red:#c8102e;--red-soft:#fde8eb;--grn:#1a7f3c;--blu:#1d4ed8;--blu-soft:#e8eefb}
body{padding:0;background:#fff}
.page{width:794px;height:1123px;max-width:none;margin:0;overflow:hidden;gap:12px;page-break-after:always}
.hero h1{font-size:32px}
.hero .sub{font-size:13px;max-width:56ch}
.note{font-size:11px;color:var(--ink2)}
.tiles.four{grid-template-columns:repeat(4,1fr)}
.tile b{font-size:24px}
.tile b.red{color:var(--red)} .tile b.grn{color:var(--grn)}
.tile span{font-size:11px;line-height:1.3;display:block}

/* timeline */
.tl{display:grid;grid-template-columns:repeat(6,1fr);gap:0;position:relative;margin:6px 0 2px}
.tl:before{content:"";position:absolute;left:4%;right:4%;top:15px;height:2px;background:var(--line)}
.tl .ev{display:flex;flex-direction:column;align-items:center;text-align:center;gap:4px;position:relative;font-size:10.5px;padding:0 4px}
.tl .dot{width:30px;height:30px;border-radius:50%;background:#fff;border:2px solid var(--ink);display:grid;place-items:center;font:700 11px var(--disp)}
.tl .dot.ok{background:var(--ink);color:#fff}
.tl .dot.miss{border-color:var(--red);color:var(--red)}
.tl .dot.next{border-style:dashed}
.tl b{font:600 11.5px var(--disp)}
.tl .miss + b,.tl .miss ~ span{color:var(--red)}

table.rep{width:100%;border-collapse:collapse;font-size:10.8px}
table.rep th{font:600 11px var(--disp);text-align:left;border-bottom:1.5px solid var(--ink);padding:5px 6px}
table.rep td{border-bottom:1px solid var(--line);padding:5px 6px;vertical-align:top}
.st{display:inline-block;font:700 9.5px var(--body);padding:1px 6px;border-radius:4px;white-space:nowrap}
.st.done{background:var(--ok-soft);color:var(--grn)}
.st.part{background:var(--amber-soft);color:var(--amber)}
.st.no{background:var(--red-soft);color:var(--red)}
.st.chg{background:var(--blu-soft);color:var(--blu)}

/* flows */
.lane{display:flex;align-items:stretch;gap:0}
.lane .b{flex:1;border:1.5px solid var(--ink);border-radius:9px;padding:6px 8px;font-size:10.5px;line-height:1.28;background:#fff}
.lane .b b{display:block;font:600 11.5px var(--disp)}
.lane .b.dark{background:var(--ink);color:#fff}
.lane .b.grn{border-color:var(--grn);background:var(--ok-soft)}
.lane .b.blu{border-color:var(--blu);background:var(--blu-soft)}
.lane .ar{flex:0 0 16px;display:grid;place-items:center;font:700 13px var(--disp);color:var(--ink2)}
.flowlabel{font:600 13px var(--disp);margin-top:2px}

/* website sketch */
.win{border:1.5px solid var(--ink);border-radius:12px;overflow:hidden}
.win .bar{background:var(--ink);color:#fff;font:500 11px var(--body);padding:6px 12px;display:flex;justify-content:space-between}
.win .bar i{font-style:normal;color:#bdbdbd}
.win .body{padding:10px 12px;display:flex;flex-direction:column;gap:8px;background:#fafafa}
.ctr{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.ctr div{background:#fff;border:1px solid var(--line);border-radius:8px;padding:5px 8px;font-size:9.5px;color:var(--ink2)}
.ctr div b{display:block;font:700 16px var(--disp);color:var(--ink)}
.ctr div.r b{color:var(--red)}
.row{display:grid;grid-template-columns:16px 1.4fr 1.3fr 80px 92px 72px 120px;gap:8px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:8px;padding:6px 8px;font-size:10px}
.row.hd{background:transparent;border:0;font:600 9.5px var(--disp);color:var(--muted);padding:0 8px}
.row b{font:600 10.5px var(--disp)}
.dots{display:flex;gap:3px;align-items:center}
.dots i{width:9px;height:9px;border-radius:50%;display:inline-block;background:var(--grn)}
.dots i.r{background:var(--red)} .dots i.g{background:#c9c9c9}
.dots span{margin-left:4px;color:var(--muted)}
.cb{width:12px;height:12px;border:1.5px solid var(--ink);border-radius:3px;display:inline-block}
.cb.on{background:var(--ink)}
.btn{background:var(--ink);color:#fff;border-radius:6px;padding:3px 8px;font:600 9.5px var(--body);text-align:center}
.new{background:var(--blu);color:#fff;border-radius:4px;padding:0 5px;font:700 8.5px var(--body);margin-left:4px}

.cmp{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.cbox{border-radius:12px;padding:10px 14px;font-size:11px;display:flex;flex-direction:column;gap:5px}
.cbox.old{border:1.5px dashed #9a9a9a;background:var(--soft)}
.cbox.new{border:2px solid var(--grn);background:var(--ok-soft)}
.cbox h3{font-size:14px}
.cbox .big{font:700 30px var(--disp)}
.cbox ol{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:2px}

.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.col{border-radius:12px;padding:10px 14px;display:flex;flex-direction:column;gap:6px}
.col.good{border:1.5px solid var(--grn);background:var(--ok-soft)}
.col.bad{border:1.5px solid var(--red);background:var(--red-soft)}
.col h3{font-size:14px}
.col ul{margin:0;padding-left:16px;display:flex;flex-direction:column;gap:4px;font-size:10.8px}
.rec{border:1.5px solid var(--ink);border-radius:12px;padding:10px 14px;font-size:10.8px}
.rec h3{font-size:14px;margin-bottom:5px}
.rec ol{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:4px}
.asks{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ask{border:1.5px solid var(--amber);background:var(--amber-soft);border-radius:10px;padding:7px 10px;font-size:10.5px}
.ask b{font:600 11.5px var(--disp);display:block}
.ask.must{border-color:var(--red);background:var(--red-soft)}
</style></head><body>
